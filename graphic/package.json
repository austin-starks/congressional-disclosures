{
  "name": "capitol-gains-graphic",
  "version": "0.0.0",
  "private": true,
  "description": "Remotion source for the Capitol Gains architecture animation in the root README.",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Architecture out/architecture.mp4 --codec=h264",
