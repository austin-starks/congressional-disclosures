{
  "name": "congressional-disclosures",
  "version": "2.1.0",
  "description": "Build a queryable SQLite lake of U.S. congressional trading disclosures (House PTRs and Senate eFD filings) from official sources: discovery, PDF decrypt/render, OCR, consensus model extraction, resumable sync, and integrity audits.",
  "license": "MIT",
  "author": "Austin Starks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austin-starks/congressional-disclosures.git",
    "directory": "packages/congressional-disclosures"
  },
  "homepage": "https://github.com/austin-starks/congressional-disclosures#readme",
  "keywords": [
    "congress",
    "disclosures",
    "ptr",
    "house",
    "senate",
    "stock-trading",
    "political-trades",
    "edgar-adjacent",
    "sqlite",
    "ocr",
    "etl",
    "data-quality",
    "extraction"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dataset": {
      "types": "./dist/dataset/index.d.ts",
      "require": "./dist/dataset/index.js",
      "default": "./dist/dataset/index.js"
    },
    "./backfill": {
      "types": "./dist/backfill/index.d.ts",
      "require": "./dist/backfill/index.js",
      "default": "./dist/backfill/index.js"
    },
    "./extraction": {
      "types": "./dist/extraction/index.d.ts",
      "require": "./dist/extraction/index.js",
      "default": "./dist/extraction/index.js"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "require": "./dist/integrity.js",
      "default": "./dist/integrity.js"
    },
    "./lake": {
      "types": "./dist/lake/index.d.ts",
      "require": "./dist/lake/index.js",
      "default": "./dist/lake/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "require": "./dist/sources/index.js",
      "default": "./dist/sources/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "require": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    }
  },
  "files": [
    "dist",
    "backfill.js",
    "backfill.d.ts",
    "extraction.js",
    "extraction.d.ts",
    "integrity.js",
    "integrity.d.ts",
    "lake.js",
    "lake.d.ts",
    "sources.js",
    "sources.d.ts",
    "storage.js",
    "storage.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "cheerio": "^1.2.0",
    "hyparquet": "^1.31.1",
    "hyparquet-compressors": "^1.1.2",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && node ../../scripts/verify-release-layout.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest"
  },
  "bin": {
    "congressional-disclosures": "dist/cli.js"
  }
}
